# Phase 0 kit settings. This is the only file you need to edit.
# Lines are KEY=VALUE. Quotes are optional. Lines starting with # are ignored.

# Your toolkit's name. Shown in the header, page titles and footer.
BRAND_NAME=Paperhaus

# Design direction. All are cream and pastel orange:
#   soft    pillowy and calm: Poppins, white cards with big radii and warm shadows,
#           pastel circle icons, a sunset-and-hills header card (the default)
#   studio  the Studiko sibling: paper cream, Geist, an italic serif word, hairlines
#   lofi    the QuackCode sibling: oat and cocoa, IBM Plex Mono, an apricot header band
#   crayon  the StudiUp sibling: Bricolage, pressable buttons, a pastel per category
#   none    BentoPDF's original dark look
THEME=soft

# Home page copy. Wrap one word in *stars* for the italic accent word.
HOME_TITLE=What are we *working on?*
HOME_SUBTITLE=Merge, split, sign, convert and more. Every tool runs right in your browser.
HOME_NOTE=Nothing is uploaded or stored

# Logo shown in the header and browser tab. Leave empty to use the Paperhaus brand mark
# from kit/brand/, or point this at your own SVG or PNG inside the repo.
BRAND_LOGO=

# Public link to your fork's source code. AGPL-3.0 requires offering the source
# to everyone who uses the site; it is written into every page as a meta tag.
SOURCE_URL=https://github.com/yashvagal/paperhaus

# Optional line at the bottom of every page. Leave empty for none.
FOOTER_TEXT=

# Your public Paperhaus website (the front page). The account menu links to it.
# Leave empty for no link. Example: https://paperhaus.vercel.app
SITE_URL=https://paperhaus.studiko.app

# OCR languages to serve from your own site (comma-separated Tesseract codes).
# eng = English. Examples: eng,spa,fra,deu,hin. Each adds a few MB.
OCR_LANGUAGES=eng

# Tools to hide, comma-separated tool IDs (the page name in the URL, without .html).
# Example: bates-numbering,posterize-pdf,pdf-to-cbz
DISABLE_TOOLS=

# Default interface language. Leave as en unless your friends prefer another.
DEFAULT_LANGUAGE=en
